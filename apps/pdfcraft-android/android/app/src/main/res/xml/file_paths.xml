<?xml version="1.0" encoding="utf-8"?>
<!-- Files of PdfCraft's that another app may reach through its FileProvider: a document being
     shared, printed or opened in another app, and a photo the camera app takes for Scan -->
<paths>
    <!-- Keep old grants valid while new shares use retained private files. -->
    <cache-path name="share" path="share/" />
    <files-path name="retained_share" path="share/" />
    <cache-path name="camera" path="camera/" />
</paths>
